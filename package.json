{
  "name": "mr-fixer",
  "version": "0.1.0",
  "private": true,
  "description": "Mr. Fixer - AI-powered website auditing tool",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:*\"",
    "test": "npm run test --workspace=backend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
